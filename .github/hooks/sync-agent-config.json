{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "node scripts/sync-agent-config.mjs --hook",
        "cwd": ".",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/sync-agent-config.mjs --hook",
        "cwd": ".",
        "timeout": 30
      }
    ]
  }
}
