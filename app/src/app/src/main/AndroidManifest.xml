<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Haptic feedback. A normal permission: granted at install, so there is no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Sending the scores of won levels to the Leak Out score server. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Noticing that the device is online again, so queued scores are sent. Normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The daily pipe reminders: notifications need this permission from Android 13, asked for in the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Setting the reminders again after a restart. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- appCategory="game" exempts the app from Android 16's large-screen override that would
         otherwise ignore the landscape lock on tablets and foldables. -->
    <application
        android:name=".LeakOutApplication"
        android:allowBackup="true"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LeakOut">

        <!-- Play Games Services v2. The id is the Play Console export in res/values/games-ids.xml;
             LeakOutApplication only starts the SDK when it is a positive number. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/app_id" />

        <!-- sensorLandscape is applied before the first frame (no portrait flash) and still lets
             the sensor flip between both landscape sides. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.LeakOut.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Debug builds add the Pipe Lab as a second launcher, merged ahead of this one.
                     Android Studio's "default activity" prefers the launcher with DEFAULT, so
                     Run still opens the game, not the lab. -->
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- A reminder alarm went off: shows its notification. Only this app sends it. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Restart, clock or time zone change: plans the reminders again. System broadcasts only. -->
        <receiver
            android:name=".reminders.ReminderRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
