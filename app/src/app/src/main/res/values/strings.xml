    <string name="tip_highlighted">Highlighted: %1$s</string>
    <string name="tip_intro_start_title">The Start</string>
    <string name="tip_intro_start_text">The liquid comes out of this valve when the countdown runs out.</string>
    <string name="tip_intro_start_target">start valve</string>
    <string name="tip_intro_finish_title">The Finish</string>
    <string name="tip_intro_finish_text">Lead the liquid into this drain to complete the level.</string>
    <string name="tip_intro_finish_target">finish drain</string>
    <string name="tip_intro_stack_title">Your Stack</string>
    <string name="tip_intro_stack_text">These are the sections you get, in order. The next one to place is at the bottom.</string>
    <string name="tip_intro_stack_target">section stack</string>
    <string name="tip_intro_place_title">Placing Sections</string>
    <string name="tip_intro_place_text">Drag the next section from the stack onto an empty cell. Build a pipe from the start to the finish.</string>
    <string name="tip_intro_place_target">next section and an empty cell</string>
    <string name="tip_intro_tap_title">Pro Tip: Tap to Place</string>
    <string name="tip_intro_tap_text">You can also tap an empty cell to place the next section there. It is much faster than dragging.</string>
    <string name="tip_intro_tap_target">an empty cell</string>
    <string name="tip_intro_zoom_title">Zoom and Pan</string>
    <string name="tip_intro_zoom_text">Pinch to zoom in or out, and drag the field to move around a larger level.</string>
    <string name="tip_intro_zoom_target">playing field</string>
    <string name="tip_cross_title">Cross Section</string>
    <string name="tip_cross_text">A cross has two separate channels and the liquid goes straight through. The first pass scores 10 points, a second pass through the other channel 50. Each channel can be used only once.</string>
    <string name="tip_cross_target">cross section in the stack</string>
    <string name="tip_reservoir_title">Reservoir</string>
    <!-- Tip about the reservoir. %1$d: the speed of the liquid in a reservoir, as a percentage of the normal speed; %% is the percent sign. -->
    <string name="tip_reservoir_text">A reservoir only connects left and right. While it fills, the liquid flows at %1$d %% speed, which buys you time. It scores 25 points.</string>
    <string name="tip_reservoir_target">reservoir in the stack</string>
    <string name="tip_mandatory_title">Mandatory Sections</string>
    <string name="tip_mandatory_text">These sections are already placed and can\'t be removed or replaced. The liquid must pass through every channel of each of them before it reaches the finish, or the level is lost.</string>
    <string name="tip_mandatory_target">mandatory sections on the field</string>
    <!-- Title of the tip about portals: two linked cells on the field; liquid that goes into one comes out of the other. -->
    <string name="tip_portal_title">Portals</string>
    <!-- Tip about portals. A pair is two portals of the same colour; it can be entered from either portal, but used only once per attempt. Portals are placed by the level, not by the player. -->
    <string name="tip_portal_text">Portals with the same colour belong together. Liquid that flows into either portal through its opening comes out of the other one, so a pair works both ways. Each pair can be used once. Portals are part of the level: they don\'t come from your stack and can\'t be replaced.</string>
    <!-- What the portal tip highlights, read after tip_highlighted: "Highlighted: the two portals of a pair". -->
    <string name="tip_portal_target">the two portals of a pair</string>
    <!-- Title of the tip about leaky tiles: cracked, damp cells on the field that drain the liquid passing them. -->
    <string name="tip_leaky_title">Leaky Tiles</string>
    <!-- Tip about leaky tiles. %1$d: the points lost each time the liquid passes one, 20. A detour around a leaky tile may score more than the short way over it. -->
    <string name="tip_leaky_text">You can place any section on a leaky tile, but the liquid that passes it drains away. Each time the liquid flows through a section on a leaky tile it scores nothing and costs you %1$d points, so a detour can be worth more.</string>
    <!-- What the leaky tile tip highlights, read after tip_highlighted: "Highlighted: leaky tiles on the field". -->
    <string name="tip_leaky_target">leaky tiles on the field</string>

