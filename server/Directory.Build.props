<Project>

  <!-- Properties shared by every project in the solution. Kept here so the individual
       project files only carry what is genuinely specific to them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Company>HexMaster</Company>
    <Product>LeakOut</Product>
    <Copyright>Copyright © HexMaster 2026</Copyright>
  </PropertyGroup>

</Project>
