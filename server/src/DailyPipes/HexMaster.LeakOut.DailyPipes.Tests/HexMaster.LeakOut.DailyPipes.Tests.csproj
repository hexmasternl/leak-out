<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HexMaster.LeakOut.DailyPipes\HexMaster.LeakOut.DailyPipes.csproj" />
    <ProjectReference Include="..\HexMaster.LeakOut.DailyPipes.Data.PostgreSQL\HexMaster.LeakOut.DailyPipes.Data.PostgreSQL.csproj" />
    <ProjectReference Include="..\HexMaster.LeakOut.DailyPipes.Generator\HexMaster.LeakOut.DailyPipes.Generator.csproj" />
  </ItemGroup>

  <!-- The conformance fixtures, shared with the app's core tests, are copied next to the test binary. -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
