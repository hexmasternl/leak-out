{{- $icons := partial "icons.html" . -}}
{{- dict
    "name" site.Title
    "short_name" site.Title
    "description" (T "siteDescription")
    "start_url" "/"
    "scope" "/"
    "display" "browser"
    "lang" "en"
    "background_color" "#0C1A2A"
    "theme_color" "#0C1A2A"
    "icons" (slice
      (dict "src" $icons.icon192.RelPermalink "sizes" "192x192" "type" "image/png")
      (dict "src" $icons.icon512.RelPermalink "sizes" "512x512" "type" "image/png")
      (dict "src" ("images/app-icon.svg" | relURL) "sizes" "any" "type" "image/svg+xml"))
  | jsonify (dict "indent" "  ") -}}
